<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body class="container">

<header>
  <%- include('../partials/header'); %>
</header>

<main>
  <h1 class="h3 mb-3">Orders</h1>

  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %>" role="alert"><%= flash.text %></div>
  <% } %>

  <% if (orders.length === 0) { %>
    <p>No orders yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">Order</th>
            <th scope="col">Customer</th>
            <th scope="col">Items</th>
            <th scope="col">Total</th>
            <th scope="col">Status</th>
            <th scope="col">Change status</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function(order) { %>
            <tr>
              <td>
                #<%= order.order_id %><br>
                <small class="text-muted"><%= new Date(order.created_at).toLocaleString('en-SG') %></small>
              </td>
              <td>
                <%= order.customer_name %><br>
                <small class="text-muted"><%= order.customer_email %></small>
              </td>
              <td>
                <% order.items.forEach(function(item) { %>
                  <div><%= item.quantity %> x <%= item.name %> (<%= item.size %>, <%= item.color %>)</div>
                <% }); %>
              </td>
              <td>$<%= order.total.toFixed(2) %></td>
              <td><span class="badge text-bg-secondary"><%= order.status %></span></td>
              <td>
                <% const next = allowedNext[order.status] || []; %>
                <% if (next.length === 0) { %>
                  <span class="text-muted">No more changes</span>
                <% } else { %>
                  <form method="POST" action="/dashboard/orders/<%= order.order_id %>/status" class="d-flex gap-2">
                    <label class="visually-hidden" for="status-<%= order.order_id %>">New status for order <%= order.order_id %></label>
                    <select id="status-<%= order.order_id %>" name="status" class="form-select form-select-sm">
                      <% next.forEach(function(s) { %>
                        <option value="<%= s %>"><%= s %></option>
                      <% }); %>
                    </select>
                    <button type="submit" class="btn btn-dark btn-sm">Update</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<footer>
  <%- include('../partials/footer'); %>
</footer>

</body>
</html>